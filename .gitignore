# 依赖与构建产物（本项目零依赖，这几行只为防手滑）
node_modules/
dist/

# 测试产物：截图由 `node tools/shoot.mjs` 随时重生成，不入库
prototype/tools/shots/

# 系统 / 编辑器
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# 临时与日志
*.log
*.tmp
npm-debug.log*

# 发布产物（本地打包用，不入库）
release/

# 部署装配出来的站点（node tools/stage-site.mjs 生成，不入库）
_site/

# wrangler 本地缓存（部署时自动生成）
.wrangler/

# 一次性补丁脚本（临时产物）
prototype/tools/patch-*.cjs

# 前后对照截图（由 node tools/shoot.mjs tools/shots-after 生成，不入库）
prototype/tools/shots-*/
